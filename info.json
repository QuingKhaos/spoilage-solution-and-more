{
  "name": "spoilage-solution-and-more",
  "title": "Spoilage Solution and More",
  "description": "Adds Spoilage Solution support to several other mods and tweaks it a bit. Configurable!",
  "author": "QuingKhaos",
  "homepage": "https://discord.gg/SYmkaDjFCt",
  "version": "1.0.0",
  "factorio_version": "2.0",
  "dependencies": [
    "base >= 2.0.77",
    "space-age >= 2.0.77",
    "(?) quality >= 2.0.77",

    "khaoslib >= 1.15.0",

    "spoilage-solution-fork >= 1.2.0",
    "spoilage-solution-lib >= 1.0.0",

    "? aquilo-seabloom-algaculture >= 0.4.4",
    "? boompuff-agriculture >= 1.1.0",
    "? fluroflux >= 1.0.2",
    "? pHactorio >= 0.2.1",

    "? barreling-group2 >= 0.5.1",
    "? bioprocessing-tab >= 1.5.0",
    "(?) Flare Stack >= 4.1.1",

    "! spoilage-solution",
    "! FrozenFood",
    "! frozen-food-and-more",
    "! frozen-goodies",
    "! frozen-goodies-and-more"
  ],
  "spoiling_required": true,
  "package": {
    "ignore": [
      "**/*.xcf"
    ]
  }
}
