{
  "name": "spoilage-solution-and-more",
  "title": "Spoilage Solution and More",
  "description": "Adds Spoilage Solution support to several other mods and tweaks it a bit. Configurable!",
  "author": "QuingKhaos",
  "homepage": "https://discord.gg/SYmkaDjFCt",
  "version": "2.0.0",
  "factorio_version": "2.1",
  "dependencies": [
    "base >= 2.1.11",
    "space-age >= 2.1.11",
    "(?) recycler >= 2.1.11",

    "khaoslib >= 2.0.1",

    "spoilage-solution-fork >= 1.2.1",
    "spoilage-solution-lib >= 2.0.0",

    "? aquilo-seabloom-algaculture >= 0.4.4",
    "? boompuff-agriculture >= 1.1.1",
    "? fluroflux >= 1.1.0",
    "? fulgora-coralmium-agriculture >= 1.2.7",
    "? pelagos >= 0.59.0",
    "? pHactorio >= 0.2.1",

    "? barreling-group2 >= 0.6.0",
    "? khaosbioprocessinggroup >= 2.0.0",
    "(?) Flare Stack >= 4.1.1",

    "! spoilage-solution",
    "! FrozenFood",
    "! frozen-food-and-more",
    "! frozen-goodies",
    "! frozen-goodies-and-more"
  ],
  "spoiling_required": true,
  "package": {
    "ignore": [
      "**/*.xcf"
    ]
  }
}
